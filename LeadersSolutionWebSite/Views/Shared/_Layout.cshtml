    <script>
     function newsLetterSubscription() {
     let emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
     if (!emailRegex.test(document.getElementById("newsLetterEmail").value)) {
         document.getElementById("newsLetterEmail").classList.add("myinput-error");
         Snackbar.show({
             text: '@LeadersSolutionWebSite.Resources.ABoutUSPage.EnterValidEmail',
             pos: 'top-center'
         });
         return false;
     }
     document.getElementById("newsLetter_form").submit();
 }
    </script>
