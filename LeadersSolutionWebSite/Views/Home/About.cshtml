@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            var message = "@ViewBag.Message";
           
            if (message) {
                Snackbar.show({
                    text: message,
                    pos: 'top-center'
                });  
            }

                       
       });
    </script>
    <script>
        function onClick(e) {
            e.preventDefault();
            grecaptcha.enterprise.ready(async () => {
                const token = await grecaptcha.enterprise.execute('6LesxrwtAAAAAPO9ffrHiNJ0YCEmeswVdsqDu8Ab', { action: 'submit' });
            });
        }
    </script>
    <script>
        function onSubmit(token) {
            $("#RecaptchaToken").val(token);
            var fields = ["name", "email", "mobile"];
            let emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            for (var i = 0; i < fields.length; i++) {
                var value = document.getElementById(fields[i]).value;

                if (!value) {
                    document.getElementById(fields[i]).classList.add("myinput-error");
                    Snackbar.show({
                        text: '@LeadersSolutionWebSite.Resources.ABoutUSPage.FillAllRequiredFields',
                        pos: 'top-center'
                    });
                    return false;
                }
            }
            if (!emailRegex.test(document.getElementById("email").value)) {
                document.getElementById("email").classList.add("myinput-error");                
                Snackbar.show({
                    text: '@LeadersSolutionWebSite.Resources.ABoutUSPage.EnterValidEmail',
                    pos: 'top-center'
                });
                return false;
            }
            document.getElementById("contact_form").submit();
        }
    </script>
    <script>
        function removeError(element) {
            element.classList.remove("myinput-error");
        }

    </script>

}






