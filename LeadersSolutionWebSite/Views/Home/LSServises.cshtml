@{
    ViewBag.Title = LeadersSolutionWebSite.Resources.LayoutPage.Services;
    HttpCookie cookie = Request.Cookies["Language"];
    string _align = "text-align:Right";


}

<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutNine.cshtml";

                _align = "text-align:left";



            }
            else
            {
                Layout = "~/Views/Shared/_LayoutNine.cshtml";

                _align = "text-align:right";



            }
        }
        else
        {
            Layout = "~/Views/Shared/_LayoutNine.cshtml";
            _align = "text-align:right";


        }
    }
</head>

