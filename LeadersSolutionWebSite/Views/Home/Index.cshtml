                        <span class="count-text plus" data-speed="5000" data-stop="@(DateTime.Now.Year - 2009)">0</span>
                        <p> @LeadersSolutionWebSite.Resources.HomePage.OurAchievementsYears</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="success-item wow fadeInUp delay-0-6s">
                        <img src="@Url.Content("~/assets/images/ClientIcon.png")" alt="Author">
                        <span class="count-text plus" data-speed="5000" data-stop="352">0</span>
