@{
    ViewBag.Title = LeadersSolutionWebSite.Resources.SolutionsPage.PageTitle;
    HttpCookie cookie = Request.Cookies["Language"];
    string _align = "text-align:Right";


}

<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutNine.cshtml";

                _align = "text-align:left";



            }
            else
            {
                Layout = "~/Views/Shared/_LayoutNine.cshtml";

                _align = "text-align:right";



            }
        }
        else
        {
            Layout = "~/Views/Shared/_LayoutNine.cshtml";
            _align = "text-align:right";


        }
    }
</head>


<section class="page-banner bgs-cover overlay rpt-100 pt-20" style="background-image: url('@Url.Content("~/assets/images/customImages/Broadtek-IT-Solutions.jpeg")'); background-size: cover; background-repeat: no-repeat; background-position: center center;">
    <div class="container">

        <div class="banner-inner text-center" style="backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);">
            <h1 class="page-title">@LeadersSolutionWebSite.Resources.SolutionsPage.PageTitle</h1>
            <h2 class="text-center">@LeadersSolutionWebSite.Resources.SolutionsPage.PageSubTitle</h2>
            <p class="text-center">@LeadersSolutionWebSite.Resources.SolutionsPage.PageTitleText</p>

        </div>
    </div>
</section>
<!-- Page Banner End -->
